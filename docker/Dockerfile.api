FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_SYSTEM_PYTHON=1
ENV PATH="/app/.venv/bin:$PATH"

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-editable

COPY . .

EXPOSE 8000

ENTRYPOINT ["docker/entrypoint.sh"]

FROM nousresearch/hermes-agent:v0.21.6 AS hermes

USER root
RUN python3 -m venv /opt/hermes-gsm-venv \
    && /opt/hermes-gsm-venv/bin/pip install --no-cache-dir \
        google-cloud-secret-manager==2.31.0

COPY apps/hermes_gateway.py /opt/hermes-gsm/apps/hermes_gateway.py
COPY clients/secret_manager.py /opt/hermes-gsm/clients/secret_manager.py
COPY docker/hermes-secrets-init.py /opt/hermes-gsm/docker/hermes-secrets-init.py
COPY docker/hermes-secrets-init.sh /etc/cont-init.d/014-hermes-google-secrets
COPY docker/hermes-clear-stale-locks.sh /etc/cont-init.d/016-hermes-clear-stale-locks
# Bundled (trusted) plugin; enable it in $HERMES_HOME/config.yaml under plugins.enabled.
COPY hermes_plugins/slack_mentions /opt/hermes/plugins/slack_mentions
COPY hermes_plugins/slack_workspace /opt/hermes/plugins/slack_workspace
COPY hermes_scripts/retreat_plan_source.py /opt/hermes-gsm/scripts/retreat_plan_source.py
COPY docker/hermes-install-scripts.sh /etc/cont-init.d/018-hermes-install-scripts
RUN chmod 0755 /etc/cont-init.d/014-hermes-google-secrets /etc/cont-init.d/016-hermes-clear-stale-locks \
        /etc/cont-init.d/018-hermes-install-scripts
