APP_ENV=dev
APP_NAME=home-agent
CONFIG_DIR=config

# Non-secret values
SUPPORT_EMAIL=you@example.com
GITHUB_REPO=your-org/your-repo

# 1Password secret references (never put raw secret values in .env)
EXTERNAL_API_KEY_REF=op://HomeAgent/ExternalApi/key
GOOGLE_CREDENTIALS_REF=op://HomeAgent/GoogleCloud/credentials_json
