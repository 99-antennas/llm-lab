ANTHROPIC_API_KEY=sk-ant-...

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT_NAME=your-gcp-project-name
GOOGLE_CLOUD_REGION=us-west4
GOOGLE_CLOUD_ZONE=us-west4-a
GOOGLE_CLOUD_KEYFILE=./path/to/service-account-key.json
GOOGLE_CLOUD_SM_KEYFILE=./path/to/secret-manager-service-account-key.json
GOOGLE_CLOUD_BUCKET_NAME=your-primary-bucket
GOOGLE_CLOUD_STORAGE_CLASS=ARCHIVE
GOOGLE_CLOUD_STORAGE_BUCKET=your-archive-bucket

# Shared Open WebUI -> Hermes authentication key, stored only in GSM.
HERMES_API_KEY_REF=gsm://your-gcp-project-id/hermes-api-key/latest
# Optional JSON secret containing SLACK_BOT_TOKEN and SLACK_APP_TOKEN.
HERMES_SLACK_CREDENTIALS_REF=gsm://your-gcp-project-id/hermes-slack-credentials/latest
SLACK_HOME_CHANNEL=your-slack-channel-id
SLACK_ALLOWED_USERS=your-slack-member-id
# Channels Shack answers without an @mention (comma-separated channel IDs).
SLACK_FREE_RESPONSE_CHANNELS=your-slack-channel-id
# Bot messages Shack answers: none | mentions (only when a bot @mentions Shack) | all.
SLACK_ALLOW_BOTS=mentions
# Flat in-channel replies need `slack: {reply_in_thread: false}` in $HERMES_HOME/config.yaml.
# Channels Shack may post tagged questions in via slack_post_message (names or IDs, comma-separated).
# Unset = Shack can't post anywhere on its own.
SLACK_POST_CHANNELS=your-slack-channel-id
# Stay silent when a message opens by @tagging someone other than Shack (they're being addressed).
SLACK_IGNORE_OTHER_USER_MENTIONS=true
# ...and their untagged follow-ups / the back-and-forth that follows, within this many minutes (default 10).
# SLACK_ADDRESSED_FOLLOWUP_MINUTES=10
# Tag reminders (cron script slack_tag_reminders.py): channels to watch (default SLACK_POST_CHANNELS),
# hours before reminding (default 24) and how far back to look (default 3 days).
# SLACK_REMINDER_CHANNELS=your-slack-channel-id
# SLACK_REMINDER_AFTER_HOURS=24
# SLACK_REMINDER_LOOKBACK_DAYS=3
# Channel activity digest injected into every Slack channel turn (all threads + top level).
# Hours to look back (0 disables) and max messages. Pair with `group_sessions_per_user: false`
# in $HERMES_HOME/config.yaml so a channel's top level is one shared conversation.
# SLACK_ACTIVITY_HOURS=24
# SLACK_ACTIVITY_MAX_MESSAGES=60
# Tool limits on Slack: everyone (people and bots, channels and DMs) gets Shack's safe tool set,
# except these users in a DM with Shack (comma-separated IDs). /cool_tools lists the safe set.
SLACK_FULL_ACCESS_USERS=your-slack-member-id
# SLACK_FILE_ROOTS=/opt/data/workspace   # where file tools may read/write on Slack
# SLACK_SAFE_TOOLS=...                   # override the safe tool list (comma-separated)
# SLACK_TOOL_LIMITS=on                   # "off" disables the limits entirely
